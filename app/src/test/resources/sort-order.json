{
  "note": "跨端共享 fixture。Kotlin 侧 SortOrderFixtureTest 与 JS 侧 sort-order-fixture.test.js 读同一份。期望顺序按 includeHidden=false 手工推导，改动任一端的比较器都必须先能解释这里为什么变。加排序键必须同步扩这份 fixture。",
  "entries": [
    { "name": "Alpha",   "isDir": true,  "size": 0,   "mtime": 300 },
    { "name": "beta",    "isDir": true,  "size": 0,   "mtime": 100 },
    { "name": "10",      "isDir": false, "size": 50,  "mtime": 500 },
    { "name": "2",       "isDir": false, "size": 300, "mtime": 200 },
    { "name": "README",  "isDir": false, "size": 100, "mtime": 400 },
    { "name": "readme",  "isDir": false, "size": 100, "mtime": 400 },
    { "name": "Äpfel",   "isDir": false, "size": 20,  "mtime": 600 },
    { "name": "apple",   "isDir": false, "size": 20,  "mtime": 600 },
    { "name": "中文",     "isDir": false, "size": 0,   "mtime": 10 },
    { "name": ".hidden", "isDir": false, "size": 999, "mtime": 999 }
  ],
  "expected": {
    "NAME:asc":  ["Alpha", "beta", "10", "2", "apple", "README", "readme", "Äpfel", "中文"],
    "NAME:desc": ["beta", "Alpha", "中文", "Äpfel", "readme", "README", "apple", "2", "10"],
    "TIME:asc":  ["beta", "Alpha", "中文", "2", "README", "readme", "10", "apple", "Äpfel"],
    "TIME:desc": ["Alpha", "beta", "apple", "Äpfel", "10", "README", "readme", "2", "中文"],
    "SIZE:asc":  ["Alpha", "beta", "中文", "apple", "Äpfel", "10", "README", "readme", "2"],
    "SIZE:desc": ["Alpha", "beta", "2", "README", "readme", "10", "apple", "Äpfel", "中文"]
  },
  "favorites": {
    "note": "收藏项两类：FILE 有 fileName/fileSize，TEXT 只有正文。名称键用**原始值**（空名就是空串），按大小排时无文件的项两个方向都在末尾。expected 里是 id 序列。",
    "items": [
      { "id": 1, "kind": "FILE", "name": "beta.apk",   "size": 900,  "createdAt": 200 },
      { "id": 2, "kind": "TEXT", "name": "alpha 片段", "size": null, "createdAt": 100 },
      { "id": 3, "kind": "FILE", "name": "Alpha.png",  "size": 0,    "createdAt": 300 },
      { "id": 4, "kind": "FILE", "name": "",           "size": 50,   "createdAt": 400 }
    ],
    "expected": {
      "NAME:asc":  [4, 2, 3, 1],
      "NAME:desc": [1, 3, 2, 4],
      "TIME:asc":  [2, 1, 3, 4],
      "TIME:desc": [4, 3, 1, 2],
      "SIZE:asc":  [3, 4, 1, 2],
      "SIZE:desc": [1, 4, 3, 2]
    }
  }
}
